{
  "name": "mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@bacons/apple-targets": "^4.0.6",
    "@nook/bridge-contracts": "workspace:*",
    "@react-native-firebase/app": "^26.3.0",
    "@react-native-firebase/messaging": "^26.3.0",
    "@react-native-seoul/kakao-login": "^5.4.2",
    "expo": "~57.0.8",
    "expo-apple-authentication": "~57.0.1",
    "expo-application": "~57.0.2",
    "expo-build-properties": "~57.0.7",
    "expo-dev-client": "~57.0.10",
    "expo-image-picker": "~57.0.8",
    "expo-location": "~57.0.19",
    "expo-notifications": "~57.0.12",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eas-cli": "^21.6.0",
    "typescript": "~6.0.3",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "expo start",
    "start:dev": "./scripts/metro.sh development 8081",
    "android": "APP_VARIANT=development expo run:android",
    "ios": "APP_VARIANT=development expo run:ios",
    "ios:device": "./scripts/run-ios-device.sh",
    "ios:signing": "node scripts/ios-signing.mjs",
    "web": "expo start --web",
    "build:ios:dev-metro": "eas build --platform ios --profile dev-metro",
    "build:ios:prod-store": "eas build --platform ios --profile prod-store",
    "build:ios:dev-metro:local": "eas build --platform ios --profile dev-metro --local --output build/dev-metro.ipa",
    "build:ios:prod-store:local": "eas build --platform ios --profile prod-store --local --output build/prod-store.ipa",
    "build:android:dev-metro": "eas build --platform android --profile dev-metro",
    "build:android:prod-store": "eas build --platform android --profile prod-store",
    "submit:ios:prod-store": "eas submit --platform ios --profile prod-store --latest",
    "submit:android:prod-store": "eas submit --platform android --profile prod-store --latest"
  },
  "private": true
}
