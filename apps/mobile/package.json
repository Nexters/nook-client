{
  "name": "mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@bacons/apple-targets": "^4.0.6",
    "@nook/bridge-contracts": "workspace:*",
    "@react-native-seoul/kakao-login": "^5.4.2",
    "expo": "~57.0.8",
    "expo-apple-authentication": "~57.0.1",
    "expo-build-properties": "~57.0.7",
    "expo-dev-client": "~57.0.10",
    "expo-image-picker": "~57.0.8",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eas-cli": "^21.6.0",
    "typescript": "~6.0.3",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:dev-metro": "eas build --platform ios --profile dev-metro",
    "build:prod-metro": "eas build --platform ios --profile prod-metro",
    "build:dev-store": "eas build --platform ios --profile dev-store",
    "build:prod-store": "eas build --platform ios --profile prod-store",
    "build:dev-store:local": "eas build --platform ios --profile dev-store --local --output build/dev-store.ipa",
    "build:prod-store:local": "eas build --platform ios --profile prod-store --local --output build/prod-store.ipa",
    "submit:dev-store": "eas submit --platform ios --profile dev-store --latest",
    "submit:prod-store": "eas submit --platform ios --profile prod-store --latest"
  },
  "private": true
}
