# 이 파일은 로컬 실행(expo run:ios/android, Metro)용이다.
# 앱 URL·식별자 기본값은 native-public-config.json 이 갖고 있고, 아래 값은 로컬에서만 덮어쓰는 용도다.
# 보통은 직접 채울 일이 없다 — 레포 루트에서 `pnpm onboard` 이 EAS 에서 값을 받아 .env.local 을 만든다.

# 카카오 로그인 네이티브 앱 키. `pnpm onboard`(eas env:pull) 이 채운다.
KAKAO_NATIVE_APP_KEY_DEV=
KAKAO_NATIVE_APP_KEY_PROD=

# (선택) 셸 WebView 가 로드할 웹 URL 오버라이드. 비우면 운영 웹.
# `pnpm dev` 는 이 값을 무시하고 이 맥의 웹 서버 주소를 직접 넘긴다 — 로컬 웹은 그걸로 본다.
# 여기에 쓴 값은 `pnpm --filter mobile start` 로 띄울 때만 적용된다 (예: http://localhost:5173).
EXPO_PUBLIC_WEB_URL=
