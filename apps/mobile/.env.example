# EXPO_PUBLIC_* 는 앱 번들에 그대로 포함되므로 공개값만 넣는다.
# 배포 환경 값은 EAS environment 에서 관리한다.

# 앱 식별자와 이름을 가르는 빌드 variant (development | production)
APP_VARIANT=

# 실기기 빌드용 Apple 개발팀 ID (10자리)
APPLE_TEAM_ID=

# 셸 WebView 가 로드할 원격 웹 URL. 실기기는 localhost 가 안 잡히니 맥의 LAN IP (예: http://192.168.0.10:4173)
EXPO_PUBLIC_WEB_URL=

# 네이티브 세션 갱신과 공유 화면 API가 쓰는 주소. 웹의 VITE_API_BASE_URL 처럼 /api/v1 까지 포함한다
EXPO_PUBLIC_API_BASE_URL=

# 카카오 네이티브 앱 키. APK 에 박히는 공개값이고 variant 마다 갱신 필요
EXPO_PUBLIC_KAKAO_APP_KEY=

# development UT 전용. production에서는 app.config.ts가 빌드를 중단한다.
EXPO_PUBLIC_UT_ACCESS_TOKEN=
EXPO_PUBLIC_UT_REFRESH_TOKEN=
