# 로컬 개발용 값. 복사해서 .env.local 로 쓴다 (.env.local 은 커밋하지 않음).
#   cp .env.example .env.local
#
# EXPO_PUBLIC_* 는 앱 번들에 그대로 포함된다 → 공개해도 되는 값만 넣을 것.
# 배포 환경(development/preview/production) 값은 EAS environment 에서 관리한다.

# 실기기 빌드용 Apple 개발팀 ID (10자리).
APPLE_TEAM_ID=

# 셸 WebView 가 로드할 원격 웹 URL.
# 실기기로 로컬 웹을 볼 때는 맥의 LAN IP 를 쓴다 (localhost 는 기기에서 안 잡힘).
#   예) EXPO_PUBLIC_WEB_URL=http://192.168.0.10:4173
EXPO_PUBLIC_WEB_URL=https://app.nook.com
