# 이 파일은 로컬 실행(expo run:ios/android)용이다.
# 앱 URL·식별자 기본값은 native-public-config.json 이 갖고 있고, 아래 값은 로컬에서만 덮어쓰는 용도다.

# 앱 식별자와 이름을 가르는 빌드 variant (development | production). 미설정 시 production.
APP_VARIANT=

# 실기기 빌드용 Apple 개발팀 ID (10자리)
APPLE_TEAM_ID=

# 카카오 로그인 네이티브 앱 키. EAS 빌드에서는 EAS Environment Variables
# (KAKAO_NATIVE_APP_KEY_DEV/PROD) 에서 자동으로 주입되고, 로컬 실행(expo run:ios/android)
# 에서만 여기 값을 채워 쓴다. variant 에 맞는 쪽만 있으면 된다.
KAKAO_NATIVE_APP_KEY_DEV=
KAKAO_NATIVE_APP_KEY_PROD=

# (선택) 셸 WebView 가 로드할 웹 URL 오버라이드.
# 실기기에서 vite preview 를 띄워 확인할 때 맥의 LAN IP 를 넣는다 (예: http://192.168.0.10:4173)
EXPO_PUBLIC_WEB_URL=

# (선택) 네이티브 세션 갱신·공유 화면 API 주소 오버라이드. /api/v1 까지 포함한다
EXPO_PUBLIC_API_BASE_URL=
