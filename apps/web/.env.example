# 로컬 개발용 값. 복사해서 .env.local 로 쓴다 (.env.local 은 커밋하지 않음).
#   cp .env.example .env.local
#
# VITE_* 는 번들에 인라인되어 브라우저에 노출된다 → 비밀값 금지.
# 배포 환경 값은 배포 플랫폼(Vercel 등)의 환경변수로 주입한다.

# BE API 베이스 URL — **오리진(또는 프록시 루트)만**. 생성된 API 경로가
# `/api/v1/...`·`/api/public/v1/...` 전체 경로를 이미 포함하므로 path 를 넣으면
# 이중 결합된다 (예: /api/v1/api/public/v1/...).
# 로컬 dev 는 vite 프록시(/api → api-dev)를 거친다. BE 가 CORS 를 열기 전까지
# 브라우저에서 직접 호출하면 preflight(OPTIONS)가 401 로 막힌다.
VITE_API_BASE_URL=/

# Vercel Preview 등 빌드된 환경에서 /dev 임시 로그인과 UI 페이지를 활성화한다.
# Production 환경에는 설정하지 않는다.
VITE_ENABLE_DEV_ROUTES=true

# 네이버 클라우드 플랫폼 Maps > Dynamic Map Client ID (Key ID)
# 콘솔의 Web 서비스 URL에 http://localhost:5173, 실제 배포 도메인을 등록해야 동작한다.
VITE_NAVER_MAP_CLIENT_ID=

# PostHog 공개 project token과 ingestion host. 로컬 dev에서는 수집하지 않는다.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# 서버 전용 BE API 베이스 URL — VITE_ 접두사가 없어 번들에 안 들어가고 서버에서만
# process.env 로 읽힌다(api/shared.ts, 공유 아카이브 OG 태그용). 위 VITE_API_BASE_URL 과
# 같은 값(오리진만, path 없이)이면 되고, 로컬 dev 는 이 함수를 안 태워도 되니 비워 둬도 된다.
# 배포(Vercel) 환경에는 반드시 채워야 한다 — 없으면 og:title/og:image 가 기본값으로 대체된다.
API_BASE_URL=

# 로컬 HTTPS 인증서는 apps/web/certs/README.md 안내에 따라 생성하고 경로를 입력한다.
DEV_HTTPS_KEY=
DEV_HTTPS_CERT=
